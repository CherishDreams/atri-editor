{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "rules": {
    "typescript/no-explicit-any": "warn",
    "no-unused-vars": "off",
    "typescript/no-unused-vars": "warn",
    "no-console": "off",
    "no-debugger": "warn",
    "eqeqeq": "warn",
    "no-var": "error",
    "prefer-const": "warn"
  },
  "categories": {
    "correctness": "warn",
    "suspicious": "warn",
    "pedantic": "off",
    "perf": "warn",
    "style": "warn"
  },
  "ignorePatterns": [
    "node_modules",
    "dist",
    "build",
    "*.min.js",
    "pnpm-lock.yaml",
    "**/node_modules/**",
    "**/dist/**"
  ]
}
