{
  "name": "atri-editor",
  "version": "0.1.0",
  "private": true,
  "description": "A framework-agnostic rich text editor based on Tiptap v3 with AI integration",
  "scripts": {
    "dev": "pnpm -C packages/core dev",
    "demo": "cd demos/vanilla && vite",
    "build": "pnpm -r build",
    "build:core": "pnpm -C packages/core build",
    "typecheck": "pnpm -C packages/core typecheck",
    "lint": "oxlint packages/core/src",
    "format": "oxfmt --write packages demos",
    "check": "pnpm typecheck && pnpm lint && oxfmt --check packages demos",
    "test": "pnpm -r --if-present test",
    "clean": "rimraf packages/*/dist"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "rimraf": "^5.0.0",
    "typescript": "^7.0.0",
    "vite": "^5.2.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}
