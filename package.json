{
  "name": "atri-editor",
  "version": "0.1.0",
  "private": true,
  "description": "A framework-agnostic rich text editor based on Tiptap v3 with AI integration",
  "scripts": {
    "dev": "pnpm -C packages/core dev",
    "demo": "pnpm -C demos/vanilla dev",
    "demo:vue": "pnpm -C demos/vue dev",
    "demo:react": "pnpm -C demos/react dev",
    "build": "pnpm -r build",
    "build:core": "pnpm -C packages/core build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "oxlint packages demos site scripts",
    "verify:side-effects": "node scripts/verify-side-effects.mjs",
    "size": "node scripts/check-size.mjs",
    "format": "oxfmt --write packages demos site scripts",
    "check": "pnpm typecheck && pnpm lint && pnpm verify:side-effects && pnpm size && oxfmt --check packages demos site scripts",
    "test": "pnpm -r --if-present test",
    "clean": "rimraf packages/*/dist",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "site": "pnpm -C site dev"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@types/node": "^20.0.0",
    "esbuild": "^0.21.5",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "rimraf": "^5.0.0",
    "typescript": "^7.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}
