{
  "name": "@atri-editor/core",
  "version": "0.1.0",
  "description": "Core package for Atri Editor",
  "keywords": [
    "editor",
    "rich-text",
    "tiptap",
    "web-component",
    "wysiwyg"
  ],
  "homepage": "https://github.com/CherishDreams/atri-editor",
  "bugs": {
    "url": "https://github.com/CherishDreams/atri-editor/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CherishDreams/atri-editor.git"
  },
  "files": [
    "dist",
    "styles.d.ts"
  ],
  "type": "module",
  "sideEffects": [
    "dist/style.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles": {
      "types": "./styles.d.ts",
      "default": "./dist/style.css"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && pnpm run build:types && pnpm run build:styles",
    "build:types": "tsc -p tsconfig.build.json",
    "build:styles": "sass src/styles/index.scss dist/style.css --style=expanded --no-source-map",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.6.0",
    "@tiptap/extension-bubble-menu": "^3.30.4",
    "@tiptap/extension-image": "^3.30.4",
    "@tiptap/extension-text-align": "^3.30.4",
    "@tiptap/extensions": "^3.30.4",
    "@tiptap/markdown": "^3.30.4",
    "@tiptap/starter-kit": "^3.30.4",
    "i18next": "^23.11.0"
  },
  "devDependencies": {
    "@tiptap/core": "^3.30.4",
    "@tiptap/pm": "^3.30.4",
    "@vitest/coverage-v8": "^3.2.7",
    "jsdom": "^30.0.1",
    "sass": "^1.103.1",
    "typescript": "^7.0.0",
    "vite": "^5.2.0",
    "vitest": "^3.2.7"
  },
  "peerDependencies": {
    "@tiptap/core": "^3.30.4",
    "@tiptap/pm": "^3.30.4"
  }
}
