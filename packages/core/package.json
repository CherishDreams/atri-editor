{
  "name": "@atri-editor/core",
  "version": "0.1.0",
  "description": "Core package for Atri Editor",
  "keywords": [
    "editor",
    "rich-text",
    "tiptap",
    "web-component",
    "wysiwyg"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/atri-editor/atri-editor.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./styles": {
      "import": "./dist/styles/index.css",
      "require": "./dist/styles/index.css"
    }
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc && vite build",
    "test": "vitest"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.6.0",
    "@tiptap/core": "^3.30.4",
    "@tiptap/extension-character-count": "^3.30.4",
    "@tiptap/extension-code-block": "^3.30.4",
    "@tiptap/extension-image": "^3.30.4",
    "@tiptap/extension-link": "^3.30.4",
    "@tiptap/extension-list": "^3.30.4",
    "@tiptap/extension-mention": "^3.30.4",
    "@tiptap/extension-table": "^3.30.4",
    "@tiptap/extension-text-align": "^3.30.4",
    "@tiptap/extension-text-style": "^3.30.4",
    "@tiptap/extensions": "^3.30.4",
    "@tiptap/markdown": "^3.30.4",
    "@tiptap/pm": "^3.30.4",
    "@tiptap/starter-kit": "^3.30.4",
    "i18next": "^23.11.0"
  },
  "devDependencies": {
    "sass": "^1.103.1",
    "typescript": "^7.0.0",
    "vite": "^5.2.0",
    "vite-plugin-dts": "^3.9.0"
  }
}
