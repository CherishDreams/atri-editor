{
  "name": "@atri-editor/code-highlight",
  "version": "0.1.1",
  "description": "Syntax highlighting for Atri Editor code blocks — brings your own lowlight instance",
  "keywords": [
    "code-block",
    "editor",
    "highlight.js",
    "lowlight",
    "rich-text",
    "syntax-highlighting",
    "tiptap"
  ],
  "homepage": "https://github.com/CherishDreams/atri-editor/tree/main/packages/code-highlight#readme",
  "bugs": {
    "url": "https://github.com/CherishDreams/atri-editor/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CherishDreams/atri-editor.git"
  },
  "files": [
    "dist",
    "theme.d.ts",
    "CHANGELOG.md",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme": {
      "types": "./theme.d.ts",
      "default": "./dist/theme.css"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && pnpm run build:types && pnpm run build:styles",
    "dev": "vite build --watch",
    "build:types": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm build",
    "build:styles": "sass src/theme.scss dist/theme.css --style=expanded --no-source-map"
  },
  "devDependencies": {
    "@atri-editor/core": "workspace:*",
    "@tiptap/core": "3.30.4",
    "@tiptap/extension-code-block": "3.30.4",
    "@tiptap/extension-code-block-lowlight": "3.30.4",
    "@tiptap/pm": "3.30.4",
    "@vitest/coverage-v8": "^3.2.7",
    "jsdom": "^30.0.1",
    "lowlight": "^3.3.0",
    "sass": "^1.103.1",
    "typescript": "^7.0.0",
    "vite": "^5.2.0",
    "vitest": "^3.2.7"
  },
  "peerDependencies": {
    "@atri-editor/core": "workspace:^",
    "@tiptap/core": "^3.30.4",
    "@tiptap/extension-code-block": "^3.30.4",
    "@tiptap/extension-code-block-lowlight": "^3.30.4",
    "@tiptap/pm": "^3.30.4",
    "lowlight": "^3.0.0"
  }
}
